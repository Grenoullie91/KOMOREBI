; Engine configuration file.
; KOMOREBI - a small premium tap-tap-kill arcade game for Android.

config_version=5

[application]

config/name="KOMOREBI"
config/description="Zerstöre die Schatten, bevor das Licht erlischt. Ein kleines Arcade-Spiel in acht Kapiteln plus Endlos-Modus."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.02, 0.027, 0.05, 1)
boot_splash/image="res://assets/icons/splash_512.png"
boot_splash/fullsize=false

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true

[gui]

theme/default_font_antialiasing=1
theme/default_font_subpixel_positioning=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=1
environment/defaults/default_clear_color=Color(0.02, 0.027, 0.05, 1)